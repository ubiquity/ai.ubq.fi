{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "serve.ts",
    "scripts/**/*.ts",
    "ops/**/*.ts",
    "benchmarks/**/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.e2e.ts"
  ],
  "project": [
    "serve.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "ops/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "includeEntryExports": true,
  "ignore": ["lib/**"],
  "ignoreDependencies": ["prettier"]
}
