{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "serve.ts",
    "scripts/**/*.ts",
    "ops/**/*.ts",
    "benchmarks/**/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.e2e.ts"
  ],
  "project": [
    "serve.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "ops/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "lib/**"
  ],
  "ignoreDependencies": [
    "prettier",
    "@std/yaml",
    "@deno/kv-utils",
    "@deno/kv-utils/import-export",
    "@deno/kv-utils/json",
    "@simplewebauthn/server"
  ],
  "ignoreIssues": {
    "serve.ts": [
      "exports"
    ],
    "src/config.ts": [
      "exports"
    ],
    "src/kv.ts": [
      "exports"
    ],
    "src/local_admin_auth.ts": [
      "exports"
    ],
    "src/provider_capacity.ts": [
      "exports"
    ]
  }
}
