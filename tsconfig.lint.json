{
  // ESLint's type-aware project. Deliberately NOT named tsconfig.json: Deno
  // auto-detects a root tsconfig.json even when deno.json exists and would adopt
  // these compilerOptions, breaking `deno check` (LINTING.md 2.1).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "serve.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "benchmarks/**/*.ts",
    "ops/**/*.ts",
    // Generated by `deno task types`. Deno does not ship `node:` or Web API
    // typings through `deno types` alone -- this ambient file is what gives the
    // type-aware rules real types. Missing it silently DROPS findings (2.5).
    ".deno-types.d.ts"
  ]
}
