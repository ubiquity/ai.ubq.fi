{
  "schema": "uos-parser-fuzz-v7",
  "common_sources": [
    "src/rt/abort.cpp",
    "src/rt/async.cpp",
    "src/rt/base64.cpp",
    "src/rt/clock.cpp",
    "src/rt/console.cpp",
    "src/rt/crypto.cpp",
    "src/rt/date.cpp",
    "src/rt/env.cpp",
    "src/rt/fetch.cpp",
    "src/rt/fetch_transport.cpp",
    "src/rt/fetch_transport_codec.cpp",
    "src/rt/fetch_transport_http.cpp",
    "src/rt/fetch_transport_net.cpp",
    "src/rt/fs.cpp",
    "src/rt/gzip.cpp",
    "src/rt/headers.cpp",
    "src/rt/http.cpp",
    "src/rt/json.cpp",
    "src/rt/kv.cpp",
    "src/rt/kv_js.cpp",
    "src/rt/kv_jsc.cpp",
    "src/rt/kv_jsc_deserialize.cpp",
    "src/rt/kv_key.cpp",
    "src/rt/kv_memory.cpp",
    "src/rt/kv_sdk.cpp",
    "src/rt/kv_sqlite.cpp",
    "src/rt/kv_value.cpp",
    "src/rt/number.cpp",
    "src/rt/process.cpp",
    "src/rt/process_loop.cpp",
    "src/rt/regex.cpp",
    "src/rt/regex_compile.cpp",
    "src/rt/regex_match.cpp",
    "src/rt/regex_tables.cpp",
    "src/rt/sqlite.cpp",
    "src/rt/stream.cpp",
    "src/rt/string.cpp",
    "src/rt/text_codec.cpp",
    "src/rt/tls.cpp",
    "src/rt/url.cpp",
    "src/rt/websocket.cpp",
    "src/rt/websocket_client.cpp",
    "src/rt/websocket_frame.cpp",
    "src/rt/websocket_socket.cpp"
  ],
  "targets": {
    "json": {
      "harness": "fuzz/json.cpp",
      "entry": "uos::rt::jsonParse",
      "max_len": 16384
    },
    "url": {
      "harness": "fuzz/url.cpp",
      "entry": "uos::rt::URL / URLSearchParams",
      "max_len": 16384
    },
    "regex": {
      "harness": "fuzz/regex.cpp",
      "entry": "uos::rt::Regex compile / exec / test",
      "max_len": 1024
    },
    "sse": {
      "harness": "fuzz/sse.cpp",
      "included_implementation": "src/responses_stream.cpp",
      "entry": "SseEventFramer::next / flush / parseEventBlock",
      "max_len": 16384
    },
    "kv_jsc": {
      "harness": "fuzz/kv_jsc.cpp",
      "entry": "uos::rt::kvJscDeserialize",
      "max_len": 16384
    },
    "bigint_library": {
      "harness": "fuzz/bigint_library.cpp",
      "entry": "uos::rt::BigInt parse / arithmetic / conversions",
      "extra_sources": [],
      "max_len": 4096
    },
    "http_request": {
      "harness": "fuzz/http_request.cpp",
      "included_implementation": "src/runtime/http.cpp",
      "entry": "ConnectionState::parseHead / decodeChunked",
      "max_len": 16384
    },
    "fetch_response": {
      "harness": "fuzz/fetch_response.cpp",
      "entry": "parseResponseHead / responseFraming / ChunkedDecoder::decode",
      "max_len": 16384
    },
    "websocket": {
      "harness": "fuzz/websocket.cpp",
      "entry": "Receiver::write / end",
      "max_len": 16384
    },
    "passkeys": {
      "harness": "fuzz/passkeys.cpp",
      "included_implementation": "src/auth/passkeys.cpp",
      "entry": "isoCBOR::decodeFirst / asn1::fromBER / parseCertificate",
      "max_len": 4096
    }
  },
  "libraries": [
    "boost_json",
    "boost_container",
    "ssl",
    "crypto",
    "z",
    "sqlite3",
    "brotlidec",
    "zstd",
    "icuuc",
    "icui18n",
    "dl",
    "pthread"
  ],
  "compile_options": [
    "-O1",
    "-gline-tables-only",
    "-fno-omit-frame-pointer",
    "-ffunction-sections",
    "-fdata-sections",
    "-fsanitize=fuzzer-no-link,address,undefined",
    "-fno-sanitize-recover=all"
  ],
  "link_options": [
    "-fuse-ld=mold",
    "-Wl,--threads=2",
    "-Wl,--gc-sections",
    "-fsanitize=fuzzer,address,undefined",
    "-fno-sanitize-recover=all"
  ],
  "runtime": {
    "max_total_time_s": 60,
    "timeout_s": 3,
    "rss_limit_mb": 768,
    "seed": 17112026,
    "jobs": 1,
    "network": "unshare user+network namespace; no interfaces raised",
    "max_depth": "At most max_len nested single-byte productions; actual JSON/kv/ASN parsers also enforce their own existing nesting/node ceilings."
  }
}
