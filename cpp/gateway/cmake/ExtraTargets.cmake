set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/cmake/extra-targets.json")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/cmake/extra-targets.json" extra_registry)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/extra-targets.json" "${extra_registry}")
string(JSON extra_count LENGTH "${extra_registry}" targets)
if(extra_count GREATER 0)
  math(EXPR extra_last "${extra_count}-1")
  foreach(index RANGE ${extra_last})
    string(JSON target GET "${extra_registry}" targets ${index} target)
    string(JSON source_count LENGTH "${extra_registry}" targets ${index} sources)
    math(EXPR source_last "${source_count}-1")
    set(objects)
    foreach(source_index RANGE ${source_last})
      string(JSON source GET "${extra_registry}" targets ${index} sources ${source_index})
      uos_object_for_source(object "${source}")
      list(APPEND objects "$<TARGET_OBJECTS:${object}>")
    endforeach()
    add_executable("${target}" EXCLUDE_FROM_ALL ${objects})
    target_link_libraries("${target}" PRIVATE uos_gateway_settings)
  endforeach()
endif()
