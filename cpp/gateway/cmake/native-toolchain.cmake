set(UOS_VIEW "$ENV{UOS_GATEWAY_TOOL_VIEW}")
if(UOS_VIEW STREQUAL "")
  message(FATAL_ERROR "The qualified native compiler view is required")
endif()
set(CMAKE_C_COMPILER "${UOS_VIEW}/bin/uos-cc" CACHE FILEPATH "Always-bounded native C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${UOS_VIEW}/bin/uos-cxx" CACHE FILEPATH "Always-bounded native compiler" FORCE)
set(CMAKE_C_COMPILER_LAUNCHER "" CACHE STRING "Compiler executable owns limits/cache" FORCE)
set(CMAKE_C_LINKER_LAUNCHER "" CACHE STRING "Compiler executable owns limits" FORCE)
set(CMAKE_CXX_COMPILER_LAUNCHER "" CACHE STRING "Compiler executable owns limits/cache" FORCE)
set(CMAKE_CXX_LINKER_LAUNCHER "" CACHE STRING "Compiler executable owns limits" FORCE)
set(CMAKE_MAKE_PROGRAM "${UOS_VIEW}/bin/ninja" CACHE FILEPATH "Pinned Ninja" FORCE)
set(CMAKE_AR "${UOS_VIEW}/bin/uos-ar" CACHE FILEPATH "Bounded host ar" FORCE)
set(CMAKE_RANLIB "${UOS_VIEW}/bin/uos-ranlib" CACHE FILEPATH "Bounded host ranlib" FORCE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
