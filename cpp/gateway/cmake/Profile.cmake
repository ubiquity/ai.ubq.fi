if(UOS_GATEWAY_IS_SDK)
  set(UOS_SDK "$ENV{UOS_CPP_TOOLCHAIN_DIR}")
  set(UOS_TARGET_LIB "${UOS_SDK}/root/usr/lib/aarch64-linux-gnu")
  target_compile_definitions(uos_gateway_settings INTERFACE BOOST_ASIO_DISABLE_AWAITABLE_FRAME_RECYCLING)
  target_link_libraries(uos_gateway_settings INTERFACE
    "${UOS_TARGET_LIB}/libboost_json.a" "${UOS_TARGET_LIB}/libboost_container.a" "${UOS_TARGET_LIB}/libboost_system.a"
    "${UOS_TARGET_LIB}/libssl.so" "${UOS_TARGET_LIB}/libcrypto.so" pthread)
  target_link_options(uos_gateway_settings INTERFACE -Wl,--no-keep-memory,--reduce-memory-overheads,--max-cache-size=67108864)
else()
  set(UOS_NATIVE_ROOT "$ENV{UOS_GATEWAY_TOOL_ROOT}")
  target_include_directories(uos_gateway_settings SYSTEM INTERFACE "${UOS_NATIVE_ROOT}/boost-1.92.0")
  target_compile_definitions(uos_gateway_settings INTERFACE UOS_GATEWAY_NATIVE_LIBRARIES=1)
  target_link_libraries(uos_gateway_settings INTERFACE /usr/lib/libboost_json.a /usr/lib/libboost_container.a
    ssl crypto sqlite3 z brotlidec zstd icuuc icui18n pthread dl)
  target_link_options(uos_gateway_settings INTERFACE -fuse-ld=mold -Wl,--threads=2 -Wl,--no-fork)
  if(UOS_GATEWAY_FRAME_RECYCLING_DISABLED)
    target_compile_definitions(uos_gateway_settings INTERFACE BOOST_ASIO_DISABLE_AWAITABLE_FRAME_RECYCLING)
  endif()
  if(UOS_GATEWAY_SANITIZER STREQUAL "address,undefined")
    list(APPEND UOS_VENDOR_PROFILE_OPTIONS -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_compile_options(uos_gateway_settings INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(uos_gateway_settings INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
  elseif(UOS_GATEWAY_SANITIZER STREQUAL "thread")
    list(APPEND UOS_VENDOR_PROFILE_OPTIONS -fsanitize=thread -fno-omit-frame-pointer)
    target_compile_options(uos_gateway_settings INTERFACE -fsanitize=thread -fno-omit-frame-pointer)
    target_link_options(uos_gateway_settings INTERFACE -fsanitize=thread -fno-omit-frame-pointer)
  endif()
  if(UOS_GATEWAY_FUZZ)
    list(APPEND UOS_VENDOR_PROFILE_OPTIONS -fsanitize=fuzzer-no-link -ffunction-sections -fdata-sections)
    target_compile_options(uos_gateway_settings INTERFACE -fsanitize=fuzzer-no-link -ffunction-sections -fdata-sections)
  endif()
  if(UOS_GATEWAY_LIBCXX)
    target_compile_options(uos_gateway_settings INTERFACE -stdlib=libc++)
    target_link_options(uos_gateway_settings INTERFACE -stdlib=libc++)
    message(STATUS "libc++ profile requires ABI-matching Boost dependency qualification before full linkage")
  endif()
endif()
