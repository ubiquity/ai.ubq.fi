  "files": {
    "include/uos/runtime/http.hpp": {
      "reviewed": true,
      "sites": [
        {
          "lines": "57-71,94-106,138-152,198-211",
          "verdict": "SAFE",
          "kinds": [
            "c"
          ],
          "symbol": "Event registration and dispatch interfaces",
          "evidence": "Registration copies the listener handle and emitter dispatch snapshots its registrations. Receiver keep-alive and listeners' capture lifetimes are classified in the implementation."
        },
        {
          "lines": "101-106,127-129,145-152,204-211,282-287",
          "verdict": "SAFE",
          "kinds": [
            "d"
          ],
          "symbol": "Borrowed node-http member accessors",
          "evidence": "In-scope callers use these member references synchronously while an owning Socket, IncomingMessage, ServerResponse or Server remains live. The WebSocket handoff moves the stream synchronously on the supplied production options."
        },
        {
          "lines": "224-238,254-265",
          "verdict": "SAFE",
          "kinds": [
            "b",
            "c"
          ],
          "symbol": "ServerListener and RequestListener",
          "evidence": "An event argument reference is only used in the synchronous wrapper, which copies the request, socket and head into the upgrade task. The server stores the callback by value."
        },
        {
          "lines": "338-368",
          "verdict": "SAFE",
          "kinds": [
            "a",
            "b",
            "c"
          ],
          "symbol": "ServeHandler, ServeHttpOptions and HttpServer",
          "evidence": "Handler arguments are owning values and the handler closure resides in ServeState, kept by request frames. Returned handle closures own ServeState. Listener and server back-edges are reviewed at their registration sites."
        }
      ]
    },
