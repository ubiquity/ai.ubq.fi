  "files": {
    "include/uos/chat/completions.hpp": {
      "status": "reviewed",
      "note": "The stream and buffered entry points have separate ownership of telemetry.",
      "sites": [
        {
          "lines": "14-17",
          "kind": "stream construction",
          "verdict": "SAFE",
          "reason": "The synchronous entry point copies the pointed-to context and retains its terminal callback in shared stream state."
        },
        {
          "lines": "18-22",
          "kind": "borrowed context",
          "verdict": "SAFE",
          "reason": "The buffered caller in envelope.cpp awaits the task with its context live, and the task copies that context before processing events."
        }
      ]
    },
    "include/uos/chat/envelope.hpp": {
      "status": "reviewed",
      "note": "Both public entry points are synchronous task factories despite their Task return types.",
      "sites": [
        {
          "lines": "6-7",
          "kind": "task factories",
          "verdict": "SAFE",
          "reason": "The wrappers copy the optional context into the coroutine arguments before returning, and the telemetry dispatcher owns its request callback."
        }
      ]
    },
