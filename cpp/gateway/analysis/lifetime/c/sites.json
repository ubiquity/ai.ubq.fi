  "files": {
    "include/uos/chat/completions.hpp": {
      "status": "reviewed",
      "note": "The stream and buffered entry points have separate ownership of telemetry.",
      "sites": [
        {
          "lines": "14-17",
          "kind": "stream construction",
          "verdict": "SAFE",
          "reason": "The synchronous entry point copies the pointed-to context and retains its terminal callback in shared stream state."
        },
        {
          "lines": "18-22",
          "kind": "borrowed context",
          "verdict": "SAFE",
          "reason": "The buffered caller in envelope.cpp awaits the task with its context live, and the task copies that context before processing events."
        }
      ]
    },
    "include/uos/chat/envelope.hpp": {
      "status": "reviewed",
      "note": "Both public entry points are synchronous task factories despite their Task return types.",
      "sites": [
        {
          "lines": "6-7",
          "kind": "task factories",
          "verdict": "SAFE",
          "reason": "The wrappers copy the optional context into the coroutine arguments before returning, and the telemetry dispatcher owns its request callback."
        }
      ]
    },
    "include/uos/chat/stream_translation.hpp": {
      "status": "reviewed",
      "note": "Translation and accumulator methods are synchronous except for the completion recorder.",
      "sites": [
        {
          "lines": "56-75",
          "kind": "container ownership",
          "verdict": "SAFE",
          "reason": "Accumulator results own shared call records. Consumers read the exposed calls vector synchronously or copy its size before suspending."
        },
        {
          "lines": "83-84",
          "kind": "stream factory",
          "verdict": "SAFE",
          "reason": "The replay iterator owns its generator body and prepared state, and the returned cancel function captures copies of the source and iterator."
        },
        {
          "lines": "90-92",
          "kind": "borrowed context",
          "verdict": "SAFE",
          "reason": "Stream or buffered completion state retains its copied context through the awaited recorder."
        }
      ]
    },
    "include/uos/codex/account_routing.hpp": {
      "status": "reviewed",
      "note": "Routing decisions accept snapshots and keys by value.",
      "sites": [
        {
          "lines": "46-48,57,68-83,90",
          "kind": "owning task parameters",
          "verdict": "SAFE",
          "reason": "The election, refresh, selection and slot recheck frames own their account, pool, model and time inputs."
        }
      ]
    },
    "include/uos/codex/auth.hpp": {
      "status": "reviewed",
      "note": "The async API owns response handles, while the shared caches are reviewed at mutation sites in auth.cpp and auth_refresh.cpp.",
      "sites": [
        {
          "lines": "203-208",
          "kind": "shared registries",
          "verdict": "SAFE",
          "reason": "The namespace owns the promise maps and uses weak response identities; consumers copy results or handles before awaiting."
        },
        {
          "lines": "230,238-244,250",
          "kind": "owning task parameters",
          "verdict": "SAFE",
          "reason": "Each probe or lookup coroutine owns its response or scalar lookup inputs."
        }
      ]
    },
