  "title": "Aggregate values across three files",
  "description": "Read every item= value under data/, sum them, and write the total to answer.txt.",
  "fixture": "seq-002",
  "fixture_revision": "sha256:8e91696f9590b2d27d601c69611585eba30eef3a976a6ced918ee03b2e939a94",
  "timeout_ms": 60000,
  "max_tool_calls": 40,
