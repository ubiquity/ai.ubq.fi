{
  "id": "long-004",
  "category": "long",
  "title": "Three phase milestones over six files (more than 20 tool calls)",
  "description": "Update six flag files in three verified phases, with a plan update and an independent check between phases; the task requires more than 20 tool calls.",
  "fixture": "long-004",
  "fixture_revision": "sha256:5bc5dbec3f0999b9404bf2a80b743131a66cc25c07acbb7880acc73a1ec82508",
  "timeout_ms": 120000,
  "max_tool_calls": 60,
  "min_tool_calls": 21,
  "min_model_calls": 0,
  "allowed_write_scope": ["**"],
  "verify": { "command": "sh tests/run.sh", "timeout_ms": 20000 },
  "oracle": {
    "file_checks": [
      { "path": "f01.txt", "kind": "equals", "value": "x=1\n" },
      { "path": "f06.txt", "kind": "equals", "value": "x=1\n" }
    ]
  },
  "scripted_trail": [
    { "tool": "task.update_plan", "args": { "plan": ["phase 1", "phase 2", "phase 3"] } },
    {
      "tool": "filesystem.find",
      "args": { "path": ".", "pattern": "f*.txt" },
      "expect": { "ok": true, "output_contains": ["f06.txt"] }
    },
    { "tool": "filesystem.read", "args": { "path": "f01.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "filesystem.read", "args": { "path": "f02.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "editor.apply_patch", "args": { "path": "f01.txt", "old": "x=0", "new": "x=1" } },
    { "tool": "editor.apply_patch", "args": { "path": "f02.txt", "old": "x=0", "new": "x=1" } },
    {
      "tool": "shell.exec",
      "args": { "command": "grep -q '^x=1$' f01.txt && grep -q '^x=1$' f02.txt" },
      "expect": { "ok": true }
    },
    { "tool": "task.update_plan", "args": { "plan": ["phase 1 done", "phase 2", "phase 3"] } },
    { "tool": "filesystem.read", "args": { "path": "f03.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "filesystem.read", "args": { "path": "f04.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "editor.apply_patch", "args": { "path": "f03.txt", "old": "x=0", "new": "x=1" } },
    { "tool": "editor.apply_patch", "args": { "path": "f04.txt", "old": "x=0", "new": "x=1" } },
    {
      "tool": "shell.exec",
      "args": { "command": "grep -q '^x=1$' f03.txt && grep -q '^x=1$' f04.txt" },
      "expect": { "ok": true }
    },
    { "tool": "task.update_plan", "args": { "plan": ["phase 1 done", "phase 2 done", "phase 3"] } },
    { "tool": "filesystem.read", "args": { "path": "f05.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "filesystem.read", "args": { "path": "f06.txt" }, "expect": { "ok": true, "output_contains": ["x=0"] } },
    { "tool": "editor.apply_patch", "args": { "path": "f05.txt", "old": "x=0", "new": "x=1" } },
    { "tool": "editor.apply_patch", "args": { "path": "f06.txt", "old": "x=0", "new": "x=1" } },
    {
      "tool": "shell.exec",
      "args": { "command": "grep -q '^x=1$' f05.txt && grep -q '^x=1$' f06.txt" },
      "expect": { "ok": true }
    },
    { "tool": "shell.exec", "args": { "command": "sh tests/run.sh" }, "expect": { "ok": true } },
    {
      "tool": "shell.exec",
      "args": { "command": "grep -rc '^x=1$' f*.txt | wc -l" },
      "expect": { "ok": true, "output_contains": ["6"] }
    },
    {
      "tool": "filesystem.search",
      "args": { "path": ".", "query": "x=1" },
      "expect": { "ok": true, "output_contains": ["f06.txt:1:x=1"] }
    },
    { "tool": "filesystem.read", "args": { "path": "f01.txt" }, "expect": { "ok": true, "output_contains": ["x=1"] } },
    { "tool": "task.update_plan", "args": { "plan": ["all phases verified"] } }
  ]
}
