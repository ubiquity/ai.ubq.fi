#!/bin/sh

set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

format_files=""
for file in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|*.md) format_files="$format_files $file" ;;
  esac
done
warn_check_failure() {
  printf '%s\n' "pre-commit: $1 failed; commit continues. Run the check manually before pushing a release." >&2
}

run_check() {
  "$@" || warn_check_failure "$1"
}

if [ -n "$format_files" ]; then
  # Repair staged formatting before the remaining commit checks run.
  if deno fmt $format_files; then
    git add -- $format_files
  else
    warn_check_failure "deno fmt"
  fi
fi
run_check deno fmt --check
run_check deno lint
run_check deno task build
run_check deno test --env --allow-net=127.0.0.1 --allow-env=CEREBRAS_API_KEY,VOYAGEAI_API_KEY,METERED_API_KEY,METERED_SYSTEM_TOKEN,METERED_USER_ID,GIT_REVISION,GITHUB_SHA,DENO_DEPLOYMENT_ID,DENO_DEPLOY_BUILD_ID --ignore=lib/codex --ignore=tests/failover-stress-http.test.ts --ignore=tests/usage-optimization-measurement.test.ts tests
run_check deno task test:measurement
