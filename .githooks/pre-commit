#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

format_files=""
for file in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|*.md) format_files="$format_files $file" ;;
  esac
done
if [ -n "$format_files" ]; then
  # Repair staged formatting before the remaining commit checks run.
  deno fmt $format_files
  git add -- $format_files
fi
deno fmt --check
deno lint
deno task build
deno test --env --allow-net=127.0.0.1 --allow-env=CEREBRAS_API_KEY,VOYAGEAI_API_KEY,METERED_API_KEY,METERED_SYSTEM_TOKEN,METERED_USER_ID,GIT_REVISION,GITHUB_SHA,DENO_DEPLOYMENT_ID,DENO_DEPLOY_BUILD_ID --ignore=lib/codex --ignore=tests/failover-stress-http.test.ts --ignore=tests/usage-optimization-measurement.test.ts tests
deno task test:measurement
