[Unit]
Description=ai.ubq.fi API gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/repos/ubiquity/ai.ubq.fi
# Retained only for the exact supported legacy Deno recovery command.
Environment=DENO_DIR=/home/codex/repos/ubiquity/ai.ubq.fi/.data/deno
Environment=DENO_TIMELINE=production
ExecStart=/bin/sh /home/codex/repos/ubiquity/ai.ubq.fi/ops/launch-vps.sh
Restart=always
RestartSec=5
# A mobile steer is discarded after about 30 seconds without an acknowledgement.
# The app-server retries a failed model stream at 5s, then 10s, then 20s, so the
# stop and restart must finish before that 20s retry. The old 180s drain let the
# client expire the steer while the gateway was still shutting down.
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
# The native control socket's physical target is in shared /tmp.
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex/repos/ubiquity/ai.ubq.fi/.data
ReadWritePaths=-/home/codex/.codex/app-server-control
# Landlock's .data write grant needs read-only mounts for nested immutable stores.
ReadOnlyPaths=/home/codex/repos/ubiquity/ai.ubq.fi/.data/releases
ReadOnlyPaths=/home/codex/repos/ubiquity/ai.ubq.fi/.data/runtimes

[Install]
WantedBy=multi-user.target
